{
  "name": "paseapp",
  "version": "1.0.0",
  "description": "Asistente de Movilidad Urbana para personas con discapacidad visual – Bahía Blanca",
  "main": "index.js",
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts,.tsx",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "expo-location": "~17.0.1",
    "expo-haptics": "~13.0.1",
    "react": "18.3.1",
    "react-native": "0.76.5",
    "react-native-vibration": "^1.0.0",
    "@react-native-community/geolocation": "^3.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@testing-library/react-native": "^12.9.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~18.3.12",
    "@types/react-native": "~0.76.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "~5.3.3"
  },
  "jest": {
    "preset": "react-native",
    "transform": {
      "^.+\\.(ts|tsx)$": ["ts-jest", { "tsconfig": "tsconfig.json" }]
    },
    "testMatch": ["**/__tests__/**/*.test.ts", "**/__tests__/**/*.test.tsx"],
    "collectCoverageFrom": ["src/**/*.{ts,tsx}", "!src/**/*.d.ts"],
    "moduleNameMapper": {
      "expo-location": "<rootDir>/src/__mocks__/expo-location.ts",
      "expo-haptics": "<rootDir>/src/__mocks__/expo-haptics.ts"
    }
  }
}
